# ==============================================================================
# ZERO AI ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure as required.
# Secrets and API keys must NEVER be committed to version control.
# ==============================================================================

# Core Application Settings
APP_NAME=Zero
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765
LOG_LEVEL=INFO

# AI Provider Configuration
# Options: demo (default, works offline with zero API keys), openai, gemini, anthropic, ollama
ZERO_MODE=local_only
AI_PROVIDER=ollama
AI_API_KEY=
AI_MODEL=llama3.2
AI_API_BASE=http://127.0.0.1:11434/v1
LOCAL_CHAT_MODEL=llama3.2
LOCAL_CODE_MODEL=qwen2.5-coder:3b
EXTERNAL_AI_ENABLED=false
WEB_SEARCH_ENABLED=false

# Voice Subsystem
VOICE_ENABLED=false
VOICE_PROVIDER=local
WAKE_WORD_ENABLED=false
WAKE_WORD=zero wake up
TTS_VOICE_RATE=180
TTS_VOICE_VOLUME=0.9

# Persistence & Database
DATABASE_URL=sqlite:///./data/zero.db
TIMEZONE=Asia/Kolkata

# Briefing & Proactivity
BRIEFING_ENABLED=true
BRIEFING_ON_STARTUP=true
BRIEFING_ON_WAKE=true
GREETING_STYLE=jarvis

# GUI & Accessibility
REDUCED_MOTION=false
GUI_THEME=jarvis_dark
